# Buffer requires the registered redirect URI to match exactly and to use HTTPS.
APP_ORIGIN=https://localhost:3443
PORT=3443
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3443/auth/buffer/callback
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=
APP_COOKIE_SECRET=
DATABASE_PATH=./data/gabel.db
# PEM files are needed locally because Buffer requires HTTPS even on localhost.
TLS_KEY_PATH=./certs/localhost-key.pem
TLS_CERT_PATH=./certs/localhost.pem
BUFFER_REQUEST_TIMEOUT_MS=15000
# Public operator/contact details shown on Gabel's legal and support pages.
OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
