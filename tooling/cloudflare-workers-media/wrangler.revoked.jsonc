{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gabel-controlled-media",
  "main": "worker.revoked.mjs",
  "compatibility_date": "2026-11-04",
  "cache": {
    "enabled": false
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
